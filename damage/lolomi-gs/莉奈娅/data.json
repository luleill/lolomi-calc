    "cons": {
        "1": {
            "name": "未完成的分类",
            "desc": [
                "施放元素战技{LINK#S11302}对策·露米呀吼吼时，或触发月笼谐奏时，莉奈娅将获得6层「历览编录」效果，该效果持续10秒，至多叠加18层。队伍中的角色造成月结晶反应伤害时，将消耗一层「历览编录」，提升造成的伤害，提升值相当于莉奈娅防御力的75%。",
                "此外，露米在究极厉害形态下使用百万吨重锤时，莉奈娅可以消耗至多5层「历览编录」，每层都会使造成的伤害提升，提升值相当于莉奈娅防御力的150%。"
            ]
        },
        "2": {
            "name": "喜或悲的谕告",
            "desc": [
                "触发月笼谐奏后的8秒内，队伍中所有元素类型为水元素与岩元素的角色的暴击伤害提升40%，且露米在究极厉害形态下使用百万吨重锤的暴击伤害额外提升150%。",
                "月兆·满辉：露米在超厉害形态下使用加力重锤时，或在究极厉害形态下使用百万吨重锤时，若附近存在月笼，则会触发一次月笼谐奏，且本次月笼谐奏视为队伍中所有元素类型为水元素与岩元素的角色均在反应中施加了元素。"
            ]
        },
        "3": {
            "name": "热闹的记录页",
            "desc": [
                "元素战技{LINK#S11302}对策·露米呀吼吼的技能等级提高3级。",
                "至多提升至15级。"
            ]
        },
        "4": {
            "name": "专家的直感觉",
            "desc": [
                "触发月笼谐奏后的5秒内，莉奈娅与队伍中自己的当前场上角色的防御力分别提升25%。莉奈娅在场上时，上述防御力提升效果可叠加。"
            ]
        },
        "5": {
            "name": "仙乡的赠别礼",
            "desc": [
                "元素爆发{LINK#S11305}备忘·绝境生存指南的技能等级提高3级。",
                "至多提升至15级。"
            ]
