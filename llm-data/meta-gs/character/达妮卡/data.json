  "cons": {
    "1": {
      "name": "冰宫殿的奉侍",
      "desc": [
        "施放特殊元素战技荡除之志或护持之志时，还会为达妮卡恢复20点元素能量，该效果每14秒至多触发一次。",
        "此外，施放元素爆发净世卫仪后，女仆·清扫者形态对应的强化效果提升120%，女仆·御前护卫形态对应的强化效果提升80%。"
      ]
    },
    "2": {
      "name": "炽流砂的静心",
      "desc": [
        "施放元素战技涤尘准锚时，达妮卡还会为队伍中附近的所有角色赋予7层祝酒。",
        "持有该效果的角色造成星超导反应伤害时，将消耗一层祝酒，提升造成的伤害，提升至相当于达妮卡攻击力的100%。",
        "此外，达妮卡在女仆·清扫者形态下造成星超导反应伤害时，还会消耗自身所有的祝酒，提升造成的伤害，提升至相当于达妮卡攻击力的150%。",
        "队伍中附近的所有角色累计消耗6层祝酒时，还会额外为队伍中自己的当前场上角色赋予1层祝酒；施放元素战技涤尘准锚或特殊元素战技护持之志时，将重置队伍中附近的所有角色拥有的祝酒层数。"
      ]
    },
    "3": {
      "name": "刃林锋的游影",
      "desc": [
        "元素爆发净世卫仪的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "4": {
      "name": "苦寒地的护持",
      "desc": [
        "处于御卫护盾庇护下的当前场上角色对敌人造成星超导反应伤害时，还会为队伍中附近的其他角色恢复3点元素能量，该效果每3.5秒至多触发一次。",
        "此外，达妮卡进入女仆·清扫者形态时，也会展开御卫护盾，持续至达妮卡退出该形态或退场。"
      ]
    },
    "5": {
      "name": "纠葛场的斡旋",
      "desc": [
        "元素战技涤尘准锚的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "6": {
      "name": "醒于晨前之星",
      "desc": [
        "准雷定锚存在期间，队伍中附近的角色造成的星超导反应伤害擢升20%。",
        "此外，达妮卡的侍者形态获得强化：",
        "女仆·御前护卫形态：基于达妮卡的攻击力，每1000点攻击力都会使队伍中当前场上角色造成的星超导反应伤害提升10%，至多提升40%；",
        "女仆·清扫者形态：基于达妮卡的攻击力，每500点攻击力都会使达妮卡的特殊元素战技荡除之志的暴击率提升2.5%，暴击伤害提升25%，至多通过这种方式使暴击率提升10%，暴击伤害提升100%。",
        "上述强化效果持续至达妮卡退出对应的侍者形态。"
      ]
    }
  },
  "passive": [
    {
      "id": 1472101,
      "name": "古海浪的咏歌",
      "desc": [
        "准雷定锚还会使附近敌人的雷元素抗性降低15%。",
        "辉映·星超导：准雷定锚附近敌人的雷元素抗性额外降低15%，冰元素抗性降低30%。"
      ]
    },
    {
      "id": 1472201,
      "name": "应是扫除之日",
      "desc": [
        "施放荡除之志后，达妮卡的攻击速度提升20%，且挥舞准雷定锚进行普通攻击命中敌人时，还会额外获得25点涤尘的心意；上述效果至多叠加3层。",
        "施放护持之志后，达妮卡的攻击力提升20%。",
        "上述每种效果分别持续至对应的侍者形态结束。"
      ]
    },
    {
      "id": 1472301,
      "name": "星耀祝礼·纤毫不遗",
      "desc": [
        "队伍中的角色触发超导反应时，将转为触发星超导反应，且基于达妮卡的攻击力，提升队伍中角色造成的星超导反应的基础伤害：每100点攻击力都将提升0.7%星超导反应的基础伤害，至多通过这种方式提升14%伤害。",
        "此外，处于极星辉域中时，达妮卡将会进入辉映·星超导状态。"
      ]
    },
    {
      "id": 1472501,
      "name": "霜雪无犯之姿",
      "desc": [
        "队伍中自己的角色处于严寒环境中时，移动速度提高10%，体力消耗降低10%。"
      ]
    }
  ],
